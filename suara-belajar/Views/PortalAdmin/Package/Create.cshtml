@{
    ViewData["Title"] = "Add Package";
    Layout = "_LayoutAdmin";

}
<div class="p-6 max-w-lg mx-auto">
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-6">

        <div class="flex justify-between items-center mb-6">
            <h2 class="text-xl font-bold text-gray-800 dark:text-gray-100">Add Package</h2>
            <a href="/admin/package"
               class="text-gray-500 hover:text-gray-700 dark:hover:text-gray-400 transition">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </a>
        </div>

        <form id="packageForm">
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Package ID</label>
                <input type="text" id="packageId"
                       class="w-full px-4 py-2 border border-gray-300 dark:border-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white"
                       placeholder="e.g. jagobacain" />
            </div>

            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Name</label>
                <input type="text" id="packageName"
                       class="w-full px-4 py-2 border border-gray-300 dark:border-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white"
                       placeholder="e.g. Jagobacain" />
            </div>

            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Logo</label>
                <input type="file" id="logoFile" accept="image/*"
                       class="w-full text-sm text-gray-700 dark:text-gray-300 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-blue-600 file:text-white hover:file:bg-blue-700" />
                <img id="logoPreview" src="" class="mt-3 w-16 h-16 object-contain rounded border border-gray-300 dark:border-gray-700 hidden">
            </div>

            <div class="mb-6 flex items-center gap-2">
                <input type="checkbox" id="isSeries" class="w-4 h-4 rounded border-gray-300 focus:ring-blue-500">
                <label for="isSeries" class="text-sm font-medium text-gray-700 dark:text-gray-300">Is Series Package</label>
            </div>

            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Explorer Styling Version</label>
                <input type="text" id="explorerStylingVersion"
                       class="w-full px-4 py-2 border border-gray-300 dark:border-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white"
                       placeholder="e.g. v2.1" />
            </div>

            <div class="flex gap-3">
                <a href="/admin/package/index"
                   class="w-full text-center py-2 rounded-lg bg-gray-300 hover:bg-gray-400 dark:bg-gray-600 dark:hover:bg-gray-500 text-gray-800 dark:text-white font-medium transition">
                    Cancel
                </a>
                <button type="submit"
                        class="w-full py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium transition">
                    Save
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    $(document).ready(function () {
        // Logo preview
        $("#logoFile").on("change", function (e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (ev) {
                    $("#logoPreview").attr("src", ev.target.result).removeClass("hidden");
                };
                reader.readAsDataURL(file);
            }
        });

        $("#packageForm").on("submit", function (e) {
            e.preventDefault();

            const packageId = $("#packageId").val().trim();
            const name = $("#packageName").val().trim();

            if (!packageId || !name) {
                alert("Package ID and Name are required.");
                return;
            }

            const formData = new FormData();
            formData.append("PackageId", packageId);
            formData.append("Name", name);
            formData.append("IsSeries", $("#isSeries").is(":checked"));
            formData.append("ExplorerStylingVersion", $("#explorerStylingVersion").val().trim());
            formData.append("IsEdit", "false");

            const fileInput = $("#logoFile")[0];
            if (fileInput.files.length > 0) {
                formData.append("LogoFile", fileInput.files[0]);
            }

            $("button[type=submit]").prop("disabled", true).text("Saving...");

            $.ajax({
                url: '/admin/package/save',
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                success: function (res) {
                    if (res.code === 200) {
                        window.location.href = "/admin/package/index";
                    } else {
                        alert(res.message || "Failed to save package.");
                        $("button[type=submit]").prop("disabled", false).text("Save");
                    }
                },
                error: function () {
                    alert("Server error. Please try again.");
                    $("button[type=submit]").prop("disabled", false).text("Save");
                }
            });
        });
    });
</script>
