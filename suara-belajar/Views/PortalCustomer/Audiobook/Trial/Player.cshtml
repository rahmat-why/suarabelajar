@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Trial Audiobook Player";
    var audiobookId = Context.Request.Query["audiobook_id"];
    Layout = "_LayoutCustomer";

    var voucher = Configuration["Voucher"];
    var message = $"Saya mau kak, mohon diproses. Kode voucher: {voucher}";
    var encodedMessage = Uri.EscapeDataString(message);
}

<!-- ===================== DETAIL ===================== -->
<div id="detail"
     class="bg-[#151517] rounded-2xl shadow-xl p-6 mb-6 text-white">
</div>

<!-- ===================== AUDIO PLAYER ===================== -->
<div id="audio-section" class="bg-[#151517] rounded-2xl shadow-xl p-6 hidden">
    <audio id="audioPlayer" playsinline preload="metadata" class="hidden"></audio>

    <div class="flex items-center gap-4">
        <button id="playBtn" class="relative w-12 h-12 rounded-full bg-[#4f1636] hover:bg-[#5d1b40] flex items-center justify-center transition">
            <svg id="playIcon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-6 h-6 fill-white"><path d="M8 5v14l11-7z" /></svg>

            <svg id="pauseIcon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-6 h-6 fill-white hidden"><path d="M6 5h4v14H6zm8 0h4v14h-4z" /></svg>

            <div id="loader" class="absolute inset-0 flex items-center justify-center hidden">
                <svg class="animate-spin h-6 w-6 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
            </div>
        </button>

        <div class="flex-1">
            <input id="progress" type="range" min="0" value="0" step="1" class="w-full accent-[#4f1636]">
            <div class="flex justify-between text-xs text-gray-400 mt-1">
                <span id="current">0:00</span>
                <span id="duration">0:00</span>
            </div>
        </div>
    </div>
</div>

<!-- ===================== PURCHASE CTA ===================== -->
<div class="bg-[#1f1f23] border border-gray-700 rounded-xl p-4 sm:p-5 mb-4 mt-4 text-center">
    <h2 class="text-lg sm:text-xl font-semibold text-white mb-2">
        Enjoying this trial? 🎧
    </h2>

    <p class="text-gray-300 text-sm sm:text-base mb-4">
        Dapatkan akses 30+ audiobook lainnya dengan menggunakan kode voucher @voucher untuk mendapatkan harga spesial dan bonus ebook, klik 👇🏻
    </p>

    <div class="flex flex-col gap-3 max-w-[300px] mx-auto">

        <!-- WhatsApp Button -->
        <a href="https://wa.me/6285796042021?text=@encodedMessage" target="_blank"
           class="inline-flex items-center justify-center gap-2
              bg-green-500 hover:bg-green-600
              text-white font-semibold py-2 px-4 rounded-lg transition">

            <svg xmlns="http://www.w3.org/2000/svg"
                 viewBox="0 0 32 32"
                 fill="white"
                 class="w-5 h-5">
                <path d="M16 .396C7.164.396 0 7.56 0 16.396c0 2.89.754 5.607 2.066 7.965L.135 31.865l7.7-2.02a15.93 15.93 0 0 0 8.165 2.236c8.837 0 16-7.164 16-16S24.837.396 16 .396zm0 29.214c-2.548 0-5.045-.668-7.24-1.934l-.518-.308-4.57 1.2 1.22-4.457-.336-.545A13.4 13.4 0 0 1 2.6 16.396C2.6 8.998 8.6 2.998 16 2.998s13.4 6 13.4 13.398-6 13.214-13.4 13.214zm7.392-9.807c-.403-.202-2.39-1.18-2.76-1.316-.37-.134-.64-.202-.91.202-.27.403-1.044 1.316-1.28 1.585-.235.27-.47.302-.873.1-.403-.202-1.7-.627-3.24-2-.12-.107-.22-.215-.318-.323-.994-1.09-1.66-2.44-1.854-2.84-.202-.403-.022-.62.18-.82.182-.18.403-.47.605-.706.202-.235.27-.403.403-.672.134-.27.067-.504-.033-.706-.1-.202-.91-2.19-1.247-3.003-.33-.79-.665-.683-.91-.695-.235-.01-.504-.012-.773-.012s-.706.1-1.077.504c-.37.403-1.413 1.38-1.413 3.36s1.447 3.89 1.65 4.16c.202.27 2.85 4.35 6.9 6.1.96.415 1.71.663 2.296.85.965.307 1.844.264 2.54.16.774-.115 2.39-.977 2.73-1.92.337-.943.337-1.75.235-1.92-.1-.168-.37-.27-.773-.47z" />
            </svg>

            Hubungi Admin
        </a>

        <!-- Explorer Button -->
        <a href="/Trial"
           class="inline-flex items-center justify-center gap-2
              bg-[#4f1636] hover:bg-[#5d1b40]
              text-white font-semibold py-2 px-4 rounded-lg transition">

            <svg xmlns="http://www.w3.org/2000/svg"
                 fill="none"
                 viewBox="0 0 24 24"
                 stroke="currentColor"
                 class="w-5 h-5">
                <path stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 19l-7-7 7-7" />
            </svg>

            Explorer
        </a>

    </div>

</div>

<!-- ===================== SCRIPT ===================== -->
<script>
    $(document).ready(loadDetail);

    function loadDetail() {
        $.ajax({
            url: "/trial/player",
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify({
                skip: 0,
                take: 0,
                data: AUDIO_ID
            }),
            success: res => {
                if (res.code === 200) {
                    renderDetail(res.data);
                } else {
                    $("#detail").html(
                        `<p class="text-red-400 text-center">${res.message}</p>`
                    );
                }
            },
            error: () => {
                $("#detail").html(
                    `<p class="text-red-400 text-center">Failed to load audiobook</p>`
                );
            }
        });
    }

    function renderDetail(item) {
        let imageUrl = window.location.origin + "/Audiobook/" + item.cover_image;
        $("#detail").html(`
            <div class="flex flex-col sm:flex-row gap-6">
                <img src="${imageUrl}" class="w-40 h-40 rounded-2xl object-cover mx-auto sm:mx-0">
                <div class="flex flex-col justify-center text-center sm:text-left">
                    <h3 class="text-2xl font-bold mb-2">${item.title}</h3>
                    <p class="text-gray-300">
                        ${item.description ?? "No description available."}
                    </p>
                </div>
            </div>
        `);

        $("#audio-section").removeClass("hidden");
    }

    /* ===================== AUDIO LOGIC ===================== */
    const AUDIO_ID = "@audiobookId";
    const audio = document.getElementById("audioPlayer");
    const playBtn = document.getElementById("playBtn");
    const loader = document.getElementById("loader");
    const playIcon = document.getElementById("playIcon");
    const pauseIcon = document.getElementById("pauseIcon");
    const progress = document.getElementById("progress");
    const current = document.getElementById("current");
    const duration = document.getElementById("duration");

    playBtn.onclick = () => {
        if (!audio.src || audio.src === "" || audio.src.includes(window.location.pathname)) {
            showLoader(true);
            audio.src = "/trial/playaudio/" + AUDIO_ID;
            audio.load();
        }

        if (audio.paused) {
            const playPromise = audio.play();
            if (playPromise !== undefined) {
                playPromise.catch(() => showLoader(false));
            }
        } else {
            audio.pause();
        }
    };

    /* Buffering Logic */
    audio.onwaiting = () => showLoader(true);
    audio.oncanplay = () => showLoader(false);
    audio.onplaying = () => showLoader(false);

    function showLoader(isLoading) {
        if (isLoading) {
            loader.classList.remove("hidden");
            playIcon.classList.add("opacity-0");
            pauseIcon.classList.add("opacity-0");
        } else {
            loader.classList.add("hidden");
            playIcon.classList.remove("opacity-0");
            pauseIcon.classList.remove("opacity-0");
        }
    }

    /* UI & Progress Logic */
    audio.onplay = () => {
        playIcon.classList.add("hidden");
        pauseIcon.classList.remove("hidden");
    };

    audio.onpause = () => {
        pauseIcon.classList.add("hidden");
        playIcon.classList.remove("hidden");
    };

    audio.onloadedmetadata = () => {
        progress.max = Math.floor(audio.duration);
        duration.textContent = formatTime(audio.duration);
    };

    audio.ontimeupdate = () => {
        if (!isNaN(audio.duration)) {
            progress.value = Math.floor(audio.currentTime);
            current.textContent = formatTime(audio.currentTime);
        }
    };

    progress.onchange = () => { audio.currentTime = progress.value; };

    function formatTime(sec) {
        if (isNaN(sec)) return "0:00";
        const m = Math.floor(sec / 60);
        const s = Math.floor(sec % 60).toString().padStart(2, "0");
        return `${m}:${s}`;
    }
</script>