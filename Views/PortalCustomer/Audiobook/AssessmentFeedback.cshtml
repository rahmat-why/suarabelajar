@{
    ViewData["Title"] = "Assessment Feedback";
    Layout = "_LayoutCustomer";
}

<div id="quiz-header" class="mt-2 space-y-1"></div>

<div id="quiz-result" class="hidden mt-6 space-y-6"></div>

<div id="loading" class="text-center py-6">
    <span class="text-gray-500 font-medium">Loading...</span>
</div>

<div id="error-box" class="hidden text-center py-10 text-gray-400"></div>

<script>
    // ==========================================
    // STATE
    // ==========================================
    const params = new URLSearchParams(window.location.search);
    const assessmentId = params.get("assessment_id");


    // ==========================================
    // DOCUMENT READY
    // ==========================================
    $(document).ready(function () {

        if (!assessmentId) {
            showError("Assessment ID tidak ditemukan.");
            return;
        }

        loadResult();

    });


    // ==========================================
    // LOAD PAST RESULT
    // ==========================================
    function loadResult() {

        $("#loading").removeClass("hidden");

        $.ajax({

            url: "/customer/assessment/result",

            method: "GET",

            data: { assessmentId: assessmentId },

            success: function (res) {

                $("#loading").addClass("hidden");

                if (res && res.code === 200 && res.data) {

                    renderHeader(res.data);

                    renderResult(res.data);

                } else {

                    showError(res && res.message ? res.message : "Gagal memuat hasil assessment.");

                }

            },

            error: function (xhr) {

                $("#loading").addClass("hidden");

                console.error("GetResult Error:", xhr.responseText);

                showError("Terjadi kesalahan saat memuat hasil assessment.");

            }

        });

    }


    // ==========================================
    // RENDER HEADER
    // ==========================================
    function renderHeader(data) {

        $("#quiz-header").html(`
                <p class="text-2xl font-extrabold text-white leading-tight">
                    ${escapeHtml(data.quiz_title || "Quiz")}
                </p>
                <p class="text-sm text-gray-400">
                    Last Submitted
                    Submitted at ${new Date(data.submit_date).toLocaleDateString("en-GB", {
                      day: "2-digit",
                      month: "short",
                      year: "numeric",
                    })}
                </p>
            `);

    }


    // ==========================================
    // RENDER RESULT
    // ==========================================
    function renderResult(data) {

        const $result = $("#quiz-result");

        $result.removeClass("hidden").empty();

        // SUMMARY
        $result.append(`
                <div class="
                    p-5
                    rounded-xl
                    border
                    ${data.is_pass ? "border-[#20d8d0] bg-[#0f2b29]" : "border-red-500 bg-[#2b0f13]"}
                ">
                    <p class="text-xl font-extrabold ${data.is_pass ? "text-[#20d8d0]" : "text-red-400"}">
                        ${data.is_pass ? "Selamat, kamu lulus!" : "Maaf, kamu belum lulus."}
                    </p>
                    <p class="text-sm text-gray-300 mt-1">
                        Score: <span class="font-semibold text-white">${data.total_point}</span>
                        / Minimum: <span class="font-semibold text-white">${data.minimum_point}</span>
                    </p>
                </div>
            `);

        // SCORE-BASED NOTES
        // Score < 50 -> notes1, otherwise -> notes2
        const scoreNote = data.total_point < 50 ? data.notes1 : data.notes2;

        if (scoreNote) {

            $result.append(`
                    <div class="p-4 rounded-xl bg-[#151517] border border-gray-700 text-sm text-gray-300">
                        ${escapeHtml(scoreNote)}
                    </div>
                `);

        }

        // PER-QUESTION BREAKDOWN
        if (Array.isArray(data.questions)) {

            data.questions.forEach(function (question, index) {

                $result.append(renderResultQuestionCard(question, index));

            });

        }

        // ACTIONS
        $result.append(`
                <div class="pt-2 flex flex-col sm:flex-row gap-3">

                    <button
                        onclick="window.location.href='/Audiobook/Explorer'"
                        class="bg-gray-700 hover:bg-gray-600
                       text-white font-semibold
                       py-2 px-6 rounded-lg transition">
                        Back to Explorer
                    </button>

                    <button
                        onclick="goToAssessment('${data.series_id || ""}')"
                        class="bg-[#4f1636] hover:bg-[#5d1b40]
                       text-white font-semibold
                       py-2 px-8 rounded-lg transition">
                        Try Again
                    </button>

                </div>
            `);

    }


    // ==========================================
    // RENDER RESULT QUESTION CARD
    // ==========================================
    function renderResultQuestionCard(question, index) {

        const options = question.options || [];

        const optionsHtml = options.map(function (opt) {

            let stateClass = "border-gray-700 bg-[#1c1c1e]";
            let badge = "";

            if (opt.is_correct && opt.is_selected) {

                // Correct and picked
                stateClass = "border-[#20d8d0] bg-[#0f2b29]";
                badge = `<span class="text-xs font-semibold text-[#20d8d0]">Jawaban benar &middot; dipilih</span>`;

            } else if (opt.is_correct && !opt.is_selected) {

                // Correct but not picked
                stateClass = "border-[#20d8d0] bg-[#0f2b29]";
                badge = `<span class="text-xs font-semibold text-[#20d8d0]">Jawaban benar</span>`;

            } else if (!opt.is_correct && opt.is_selected) {

                // Picked but wrong
                stateClass = "border-red-500 bg-[#2b0f13]";
                badge = `<span class="text-xs font-semibold text-red-400">Dipilih &middot; salah</span>`;

            }

            return `
                    <div class="flex items-center justify-between gap-3 p-3 rounded-lg border ${stateClass}">
                        <span class="text-sm sm:text-base text-gray-100">
                            ${escapeHtml(opt.option_text)}
                        </span>
                        ${badge}
                    </div>
                `;

        }).join("");

        const questionWasCorrect =
            options.length > 0 &&
            options.every(o => (o.is_correct && o.is_selected) || (!o.is_correct && !o.is_selected));

        return `
                <div class="p-4 sm:p-5 rounded-xl bg-[#151517] border border-gray-700 space-y-3">

                    <div class="flex items-start justify-between gap-3">

                        <div class="text-sm sm:text-base font-semibold text-white">
                            ${index + 1}. ${escapeHtml(question.question)}
                        </div>

                        <div class="
                            shrink-0
                            text-xs
                            font-bold
                            px-2
                            py-1
                            rounded
                            ${questionWasCorrect ? "bg-[#0f2b29] text-[#20d8d0]" : "bg-[#2b0f13] text-red-400"}
                        ">
                            ${questionWasCorrect ? "BENAR" : "SALAH"}
                        </div>

                    </div>

                    <div class="space-y-2">
                        ${optionsHtml}
                    </div>

                    ${question.reason_correct ? `
                        <div class="mt-2 p-3 rounded-lg bg-[#1c1c1e] border border-gray-700">
                            <p class="text-xs font-semibold text-gray-400 mb-1">Pembahasan</p>
                            <p class="text-sm text-gray-200">${escapeHtml(question.reason_correct)}</p>
                        </div>
                    ` : ""}

                </div>
            `;

    }


    // ==========================================
    // GO TO ASSESSMENT (RETRY)
    // ==========================================
    function goToAssessment(seriesId) {

        if (!seriesId) {
            window.location.href = "/Audiobook/Explorer";
            return;
        }

        window.location.href =
            "/Assessment?series_id=" + encodeURIComponent(seriesId);

    }


    // ==========================================
    // SHOW ERROR
    // ==========================================
    function showError(message) {

        $("#error-box")
            .removeClass("hidden")
            .text(message);

    }


    // ==========================================
    // ESCAPE HTML
    // Prevent HTML injection from API data
    // ==========================================
    function escapeHtml(value) {

        if (value === null || value === undefined) {
            return "";
        }

        return String(value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");

    }

</script>
