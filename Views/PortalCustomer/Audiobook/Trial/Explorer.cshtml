@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Trial";
    Layout = "_LayoutCustomer";

    var voucher = Configuration["Voucher"];
    var message = $"Saya mau kak, mohon diproses. Kode voucher: {voucher}";
    var encodedMessage = Uri.EscapeDataString(message);
}
<!-- PAGE TITLE -->
<div class="mb-4">
    <h1 class="text-xl font-semibold text-white">
        Free Trial Jagobacain
    </h1>
</div>

<div class="space-y-4">

    <div class="border-b border-gray-700">
        <button class="pb-2 px-1 text-white border-b-2 border-white font-semibold cursor-default">
            Audiobook
        </button>
    </div>

    <div id="trial-list"
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    </div>

</div>

<!-- ===================== PURCHASE CTA ===================== -->
<div class="bg-[#1f1f23] border border-gray-700 rounded-xl p-4 sm:p-5 mb-4 mt-4 text-center">
    <h2 class="text-lg sm:text-xl font-semibold text-white mb-2">
        Enjoying this trial? 🎧
    </h2>

    <p class="text-gray-300 text-sm sm:text-base mb-4">
        Dapatkan akses 30+ audiobook lainnya dengan menggunakan kode voucher @voucher untuk mendapatkan harga spesial dan bonus ebook, klik 👇🏻
    </p>

    <div class="flex flex-col gap-3 max-w-[300px] mx-auto">

        <a href="https://wa.me/6285796042021?text=@encodedMessage" target="_blank"
           class="inline-flex items-center justify-center gap-2
              bg-green-500 hover:bg-green-600
              text-white font-semibold py-2 px-4 rounded-lg transition">

            <svg xmlns="http://www.w3.org/2000/svg"
                 viewBox="0 0 32 32"
                 fill="white"
                 class="w-5 h-5">
                <path d="M16 .396C7.164.396 0 7.56 0 16.396c0 2.89.754 5.607 2.066 7.965L.135 31.865l7.7-2.02a15.93 15.93 0 0 0 8.165 2.236c8.837 0 16-7.164 16-16S24.837.396 16 .396zm0 29.214c-2.548 0-5.045-.668-7.24-1.934l-.518-.308-4.57 1.2 1.22-4.457-.336-.545A13.4 13.4 0 0 1 2.6 16.396C2.6 8.998 8.6 2.998 16 2.998s13.4 6 13.4 13.398-6 13.214-13.4 13.214zm7.392-9.807c-.403-.202-2.39-1.18-2.76-1.316-.37-.134-.64-.202-.91.202-.27.403-1.044 1.316-1.28 1.585-.235.27-.47.302-.873.1-.403-.202-1.7-.627-3.24-2-.12-.107-.22-.215-.318-.323-.994-1.09-1.66-2.44-1.854-2.84-.202-.403-.022-.62.18-.82.182-.18.403-.47.605-.706.202-.235.27-.403.403-.672.134-.27.067-.504-.033-.706-.1-.202-.91-2.19-1.247-3.003-.33-.79-.665-.683-.91-.695-.235-.01-.504-.012-.773-.012s-.706.1-1.077.504c-.37.403-1.413 1.38-1.413 3.36s1.447 3.89 1.65 4.16c.202.27 2.85 4.35 6.9 6.1.96.415 1.71.663 2.296.85.965.307 1.844.264 2.54.16.774-.115 2.39-.977 2.73-1.92.337-.943.337-1.75.235-1.92-.1-.168-.37-.27-.773-.47z" />
            </svg>

            Hubungi Admin
        </a>

        <a href="/"
           class="inline-flex items-center justify-center gap-2
              bg-[#4f1636] hover:bg-[#5d1b40]
              text-white font-semibold py-2 px-4 rounded-lg transition">

            <svg xmlns="http://www.w3.org/2000/svg"
                 fill="none"
                 viewBox="0 0 24 24"
                 stroke="currentColor"
                 class="w-5 h-5">
                <path stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 19l-7-7 7-7" />
            </svg>

            Redeem Code
        </a>

    </div>

</div>

<div id="loading" class="text-center py-6 hidden">
    <span class="text-gray-500 font-medium">Loading...</span>
</div>

<script>
    let skip = 0;
    let take = 1;
    let isLoading = false;
    let isEnd = false;

    $(document).ready(function () {
        loadMore();
    });

    function loadMore() {
        if (isLoading || isEnd) return;

        isLoading = true;
        $("#loading").removeClass("hidden");

        $.ajax({
            url: "/trial/explorer",
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify({ skip, take }),
            success: function (res) {

                if (res.code === 200 && Array.isArray(res.data)) {

                    if (res.data.length === 0) {
                        isEnd = true;
                    } else {
                        renderTrial(res.data);

                        skip += take;

                        finishLoading();
                    }
                }

                finishLoading();
            },
            error: finishLoading
        });
    }

    function finishLoading() {
        isLoading = false;
        $("#loading").addClass("hidden");
    }

    // ===============================
    // TRIAL RENDER
    // ===============================
    function renderTrial(items) {
        if (!Array.isArray(items)) return;

        items.forEach(item => {
            $("#trial-list").append(renderCard(item));
        });
    }

    // ===============================
    // CARD
    // ===============================
    function renderCard(item) {
        return `
            <div onclick="goToPlayer('${item.audiobook_id}')"
                    class="relative bg-[#151517] rounded-xl shadow hover:shadow-lg transition cursor-pointer p-3 sm:p-4 flex gap-3 sm:gap-4">
                        
                    <img src="Audiobook/${item.cover_image}" class="w-16 h-16 sm:w-20 sm:h-20 rounded-lg object-cover flex-shrink-0">

                <div class="flex flex-col justify-center pr-10">
                    <div class="text-sm sm:text-base font-semibold text-gray-100 line-clamp-2">
                        ${item.title}
                    </div>
                </div>

                <div class="absolute bottom-3 right-3 sm:bottom-4 sm:right-4">
                    <div class="w-9 h-9 bg-[#4f1636] hover:bg-[#5d1b40] rounded-full flex items-center justify-center shadow-lg">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                fill="white" class="w-4 h-4 ml-0.5">
                            <path d="M8 5v14l11-7z" />
                        </svg>
                    </div>
                </div>

            </div>`;
    }

    function goToPlayer(id) {
        window.location.href = "/trial/player?audiobook_id=" + id;
    }
</script>