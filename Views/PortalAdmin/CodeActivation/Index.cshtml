@{
    ViewData["Title"] = "Serial Number";
    Layout = "_LayoutAdmin";
}

<div class="p-6 max-w-7xl mx-auto">
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-4">
        <h2 class="text-2xl font-bold mb-4 text-gray-800 dark:text-gray-100">
            Serial Number
        </h2>

        <!-- Summary -->
        <div class="grid grid-cols-6 gap-4 mb-6">
            <div class="bg-green-100 dark:bg-green-800 p-4 rounded-lg text-center">
                <h3 class="text-lg font-semibold text-green-800 dark:text-green-200">Active</h3>
                <p id="totalActive" class="text-2xl font-bold text-green-800 dark:text-green-200">0</p>
            </div>
            <div class="bg-red-100 dark:bg-red-800 p-4 rounded-lg text-center">
                <h3 class="text-lg font-semibold text-red-800 dark:text-red-200">Deleted</h3>
                <p id="totalNotActive" class="text-2xl font-bold text-red-800 dark:text-red-200">0</p>
            </div>
        </div>

        <!-- Filters -->
        <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
            <input id="tableSearch" type="text" placeholder="Search Serial..."
                   class="px-4 py-2 border rounded-lg w-64 dark:bg-gray-700 dark:text-white" />

            <div class="flex gap-3">
                <select id="statusFilter" class="px-4 py-2 border rounded-lg dark:bg-gray-700 dark:text-white">
                    <option value="">ALL Status</option>
                    <option value="Active">Active</option>
                    <option value="Not Active">Not Active</option>
                </select>

                <select id="packageFilter" class="px-4 py-2 border rounded-lg dark:bg-gray-700 dark:text-white">
                    <option value="">ALL Package</option>
                    <option value="jagobacain">Jagobacain</option>
                    <option value="islambercerita">Islambercerita</option>
                    <option value="jagobacain V2">Jagobacain V2</option>
                </select>
            </div>
        </div>

        <!-- Table -->
        <table class="min-w-full divide-y dark:divide-gray-700">
            <thead class="bg-gray-100 dark:bg-gray-700">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-200 uppercase tracking-wider">Serial Number</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-200 uppercase tracking-wider">Package</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-200 uppercase tracking-wider">Created At</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-200 uppercase tracking-wider">Used At</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-200 uppercase tracking-wider">Status</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-200 uppercase tracking-wider">Action</th>
                </tr>
            </thead>
            <tbody id="tableBody" class="bg-white dark:bg-gray-800 divide-y dark:divide-gray-700"></tbody>
        </table>

        <!-- Pagination -->
        <div class="flex justify-between items-center mt-4">
            <button id="prevPage" class="px-4 py-2 bg-blue-500 text-white rounded">Previous</button>
            <span id="pageInfo"></span>
            <button id="nextPage" class="px-4 py-2 bg-blue-500 text-white rounded">Next</button>
        </div>
    </div>
</div>

<!-- Modal for Redeem Log -->
<div id="logModal" class="fixed inset-0 hidden items-center justify-center bg-black bg-opacity-50 z-50">
    <div class="bg-white dark:bg-gray-800 p-6 rounded-lg max-w-lg w-full">
        <h3 class="text-xl font-bold mb-4 text-gray-800 dark:text-gray-100">Redeem Log</h3>
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 mb-4">
            <thead>
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-200 uppercase tracking-wider">Device/Browser Key</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-200 uppercase tracking-wider">Redeemed At</th>
                </tr>
            </thead>
            <tbody id="logBody" class="divide-y divide-gray-200 dark:divide-gray-700"></tbody>
        </table>
        <div class="text-right">
            <button id="closeModal" class="px-4 py-2 bg-gray-500 text-white rounded">Close</button>
        </div>
    </div>
</div>

<script>
    let page = 1;
    const size = 10;
    let totalPage = 1;

    function loadData() {
        $.ajax({
            url: '/admin/codeactivation/load',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                Skip: (page - 1) * size,
                Take: size,
                Data: $('#tableSearch').val(),
                Status: $('#statusFilter').val(),
                Package: $('#packageFilter').val()
            }),
            success: res => {
                const tbody = $('#tableBody');
                tbody.empty();

                if (!res.data.length) {
                    tbody.append(`<tr><td colspan="6" class="text-center p-4">No Data</td></tr>`);
                }

                res.data.forEach(r => {
                    tbody.append(`
                        <tr>
                            <td class="px-4 py-2">${r.serial_number}</td>
                            <td class="px-4 py-2">${r.package}</td>
                            <td class="px-4 py-2">${formatDate(r.created_date)}</td>
                            <td class="px-4 py-2">${formatDate(r.used_date)}</td>
                            <td class="px-4 py-2">
                                <span class="px-2 py-1 rounded ${r.status === 'Active' ? 'bg-green-200' : 'bg-red-200'}">${r.status}</span>
                            </td>
                            <td class="px-4 py-2">
                                ${r.status !== 'Active' ? `<button class="logBtn px-2 py-1 bg-gray-500 text-white rounded" data-sn="${r.serial_number}">LOG</button>` : ''}
                            </td>
                        </tr>
                    `);
                });

                $('#totalActive').text(res.totalActive);
                $('#totalNotActive').text(res.totalNotActive);

                totalPage = Math.ceil(res.recordsFiltered / size);
                $('#pageInfo').text(`Page ${page} of ${totalPage}`);
                $('#prevPage').prop('disabled', page <= 1);
                $('#nextPage').prop('disabled', page >= totalPage);
            }
        });
    }

    function formatDate(d) {
        if (!d) return '-';
        return new Date(d).toLocaleDateString() + ' ' + new Date(d).toLocaleTimeString();
    }

    $('#tableSearch, #statusFilter, #packageFilter').on('change keyup', () => { page = 1; loadData(); });
    $('#prevPage').click(() => { if (page > 1) { page--; loadData(); } });
    $('#nextPage').click(() => { if (page < totalPage) { page++; loadData(); } });

    // Handle LOG button click
    $(document).on('click', '.logBtn', function () {
        const sn = $(this).data('sn');
        $('#logBody').empty();
        $.ajax({
            url: '/admin/codeactivation/log',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ SerialNumber: sn }),
            success: res => {
                if (!res.data.length) {
                    $('#logBody').append(`<tr><td colspan="2" class="text-center p-2">No Logs</td></tr>`);
                } else {
                    res.data.forEach(l => {
                        $('#logBody').append(`
                            <tr>
                                <td class="px-4 py-2">${l.browserKey}</td>
                                <td class="px-4 py-2">${formatDate(l.redeemedAt)}</td>
                            </tr>
                        `);
                    });
                }
                $('#logModal').removeClass('hidden').addClass('flex');
            }
        });
    });

    // Close modal
    $('#closeModal').click(() => {
        $('#logModal').addClass('hidden').removeClass('flex');
    });

    loadData();
</script>