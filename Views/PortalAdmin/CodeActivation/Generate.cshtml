@{
    ViewData["Title"] = "Generate Code";
    Layout = "_LayoutAdmin";
}

<div class="p-6 max-w-xl mx-auto bg-white dark:bg-gray-800 rounded-xl shadow-lg">
    <h2 class="text-2xl font-bold mb-6 text-gray-800 dark:text-gray-100 text-center">
        Generate Serial Number
    </h2>

    <!-- Package -->
    <div class="mb-4">
        <label class="block text-gray-700 dark:text-gray-200 font-medium mb-1">
            Package:
        </label>

        <select id="package"
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-700 rounded-lg
                   dark:bg-gray-700 dark:text-white">

            <option value="">-- Select Package --</option>

        </select>
    </div>

    <!-- Number -->
    <div class="mb-4">
        <label class="block text-gray-700 dark:text-gray-200 font-medium mb-1">
            Number of SN:
        </label>
        <input type="number" id="numberOfCodes" min="0" max="100" value="0"
               class="w-full px-4 py-2 border border-gray-300 dark:border-gray-700 rounded-lg
                      dark:bg-gray-700 dark:text-white">
    </div>

    <!-- Button -->
    <div class="text-center mb-6">
        <button id="generateBtn"
                class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-6 rounded-lg">
            Generate & Save
        </button>
    </div>

    <!-- Preview -->
    <h3 class="text-lg font-semibold mb-2 text-gray-800 dark:text-gray-100">
        Generated SN:
    </h3>
    <div class="max-h-64 overflow-y-auto mb-4 border rounded-lg p-2
                bg-gray-50 dark:bg-gray-900">
        <ul id="codesList" class="list-disc list-inside text-gray-700 dark:text-gray-200"></ul>
    </div>

    <p id="result" class="font-medium"></p>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function () {

        const chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";

        // ==========================================
        // Generate random code
        // ==========================================
        function generateCode() {
            let code = "";

            for (let i = 0; i < 8; i++) {
                code += chars[Math.floor(Math.random() * chars.length)];
            }

            return "SB-" + code;
        }


        // ==========================================
        // Load packages from database
        // ==========================================
        function loadPackages() {

            $.ajax({
                url: "/admin/codeactivation/packages",
                type: "GET",

                success: function (response) {

                    if (!response.success) {
                        console.error(response.error);
                        return;
                    }

                    const packageSelect = $("#package");

                    // Clear existing options
                    packageSelect.empty();

                    // Default option
                    packageSelect.append(
                        $("<option>", {
                            value: "",
                            text: "-- Select Package --"
                        })
                    );

                    // Add packages
                    response.data.forEach(function (item) {

                        packageSelect.append(
                            $("<option>", {
                                value: item.package_id,
                                text: item.name
                            })
                        );

                    });

                },

                error: function (xhr, status, error) {
                    console.error("Failed to load packages:", error);
                    console.error(xhr.responseText);
                }
            });

        }


        // ==========================================
        // Number of codes input
        // ==========================================
        $("#numberOfCodes").on("input", function () {

            let count = parseInt(this.value) || 0;

            // Limit 0 - 100
            count = Math.min(Math.max(count, 0), 100);

            this.value = count;

            // Clear previous codes
            $("#codesList").empty();

            // Generate preview codes
            for (let i = 0; i < count; i++) {

                $("#codesList").append(
                    $("<li>").text(generateCode())
                );

            }

        });


        // ==========================================
        // Generate button
        // ==========================================
        $("#generateBtn").click(function (e) {

            e.preventDefault();

            const number = parseInt($("#numberOfCodes").val()) || 0;

            // Get package_id
            const packageId = $("#package").val();


            // ==========================================
            // Validation
            // ==========================================
            if (!packageId) {

                alert("Please select package");

                $("#package").focus();

                return;
            }


            if (number < 1 || number > 100) {

                alert("Please enter a number between 1 and 100");

                $("#numberOfCodes").focus();

                return;
            }


            // Disable button to prevent double click
            $("#generateBtn")
                .prop("disabled", true)
                .text("Generating...");


            // ==========================================
            // Send request to server
            // ==========================================
            $.ajax({

                url: "/admin/codeactivation/generate",

                type: "POST",

                contentType: "application/json",

                data: JSON.stringify({
                    Data: number.toString(),
                    Package: packageId
                }),

                success: function (res) {

                    $("#codesList").empty();


                    if (res.code === 200) {

                        // Show generated codes
                        if (res.data && res.data.length > 0) {

                            res.data.forEach(function (code) {

                                $("#codesList").append(
                                    $("<li>").text(code)
                                );

                            });

                        }


                        // Show success message
                        $("#result")
                            .text(res.message)
                            .removeClass("text-red-500")
                            .addClass("text-green-500");


                        // Redirect after 1 second
                        setTimeout(function () {

                            window.location.href =
                                "/admin/codeactivation";

                        }, 1000);

                    } else {

                        $("#result")
                            .text(res.message || "Failed to generate codes")
                            .removeClass("text-green-500")
                            .addClass("text-red-500");


                        // Enable button again
                        $("#generateBtn")
                            .prop("disabled", false)
                            .text("Generate");

                    }

                },

                error: function (xhr, status, error) {

                    console.error("Generate error:", error);
                    console.error(xhr.responseText);

                    $("#result")
                        .text("An error occurred while generating codes.")
                        .removeClass("text-green-500")
                        .addClass("text-red-500");


                    // Enable button again
                    $("#generateBtn")
                        .prop("disabled", false)
                        .text("Generate");

                }

            });

        });


        // ==========================================
        // Initial load
        // ==========================================
        loadPackages();

    });
</script>