@{
    ViewData["Title"] = "Reading Summary";
    Layout = "_LayoutAdmin";
}
<div class="p-6 max-w-7xl mx-auto">
    <div class="overflow-x-auto bg-white dark:bg-gray-800 rounded-xl shadow-lg p-4">

        <div class="flex justify-between items-center mb-4">
            <h2 class="text-2xl font-bold text-gray-800 dark:text-gray-100">Reading Summary</h2>
            <a href="/admin/reading/create"
               class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg shadow transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Add Summary
            </a>
        </div>

        <div class="mb-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <input type="text" id="tableSearch" placeholder="Search by audiobook title..."
                   class="px-4 py-2 border border-gray-300 dark:border-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white w-full sm:w-64">

            <select id="audiobookFilter"
                    class="px-4 py-2 border border-gray-300 dark:border-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white w-full sm:w-auto">
                <option value="">All Audiobooks</option>
            </select>
        </div>

        <table id="summaryTable" class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
            <thead class="bg-gray-50 dark:bg-gray-700">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-200 uppercase tracking-wider">Audiobook</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-200 uppercase tracking-wider">Description Preview</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-200 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700"></tbody>
        </table>

        <div class="mt-4 flex justify-between items-center text-gray-700 dark:text-gray-200">
            <button id="prevPage" class="px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600 disabled:opacity-50">Previous</button>
            <span id="pageInfo">Page 1 of 1</span>
            <button id="nextPage" class="px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600 disabled:opacity-50">Next</button>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        let currentPage = 1;
        const pageSize = 10;
        let totalPages = 1;

        $.ajax({
            url: '/admin/reading/list-audiobook',
            type: 'GET',
            success: function (res) {
                if (res.code === 200 && Array.isArray(res.data)) {
                    res.data.forEach(a => {
                        $("#audiobookFilter").append(`<option value="${a.audiobook_id}">${a.title}</option>`);
                    });
                }
            }
        });

        function currentFilters() {
            return [$("#tableSearch").val(), $("#audiobookFilter").val()];
        }

        function loadTable(search = "", audiobookId = "") {
            $.ajax({
                url: '/admin/reading/load',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    Draw: 0,
                    Skip: (currentPage - 1) * pageSize,
                    Take: pageSize,
                    Data: search,
                    Audiobook: audiobookId
                }),
                success: function (res) {
                    const tbody = $("#summaryTable tbody");
                    tbody.empty();

                    if (!res.data || res.data.length === 0) {
                        tbody.append(`<tr><td colspan="3" class="px-6 py-4 text-center text-gray-500 dark:text-gray-300">No records found.</td></tr>`);
                        totalPages = 1;
                    } else {
                        res.data.forEach(row => {
                            tbody.append(`
                                <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 transition">
                                    <td class="px-6 py-4 text-gray-800 dark:text-gray-100 font-medium">${row.audiobook_title}</td>
                                    <td class="px-6 py-4 text-gray-600 dark:text-gray-300 text-sm">${row.description_preview || '-'}</td>
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-2">
                                            <a href="/admin/reading/edit/${row.summary_id}"
                                               class="inline-flex items-center px-3 py-1.5 bg-yellow-500 hover:bg-yellow-600 text-white text-sm font-medium rounded-lg shadow transition">
                                                Edit
                                            </a>
                                            <button onclick="deleteSummary('${row.summary_id}')"
                                                    class="inline-flex items-center px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white text-sm font-medium rounded-lg shadow transition">
                                                Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            `);
                        });

                        totalPages = Math.ceil(res.recordsFiltered / pageSize);
                    }

                    $("#pageInfo").text(`Page ${currentPage} of ${totalPages}`);
                    $("#prevPage").prop("disabled", currentPage === 1);
                    $("#nextPage").prop("disabled", currentPage === totalPages);
                },
                error: function () {
                    alert("Failed to load data.");
                }
            });
        }

        loadTable();

        $("#tableSearch").on("keyup", function () { currentPage = 1; loadTable(...currentFilters()); });
        $("#audiobookFilter").on("change", function () { currentPage = 1; loadTable(...currentFilters()); });
        $("#prevPage").click(function () { if (currentPage > 1) { currentPage--; loadTable(...currentFilters()); } });
        $("#nextPage").click(function () { if (currentPage < totalPages) { currentPage++; loadTable(...currentFilters()); } });

        window.deleteSummary = function (summaryId) {
            if (!confirm("Yakin mau hapus summary ini?")) return;

            $.ajax({
                url: '/admin/reading/delete',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ Summary: summaryId.toString() }),
                success: function (res) {
                    if (res.code === 200) {
                        loadTable(...currentFilters());
                    } else {
                        alert(res.message || "Failed to delete summary.");
                    }
                },
                error: function () {
                    alert("Server error. Please try again.");
                }
            });
        };
    });
</script>