@{
    ViewData["Title"] = "Audiobook Islambercerita";
    Layout = "_LayoutAdmin";
}

<div class="p-6 max-w-7xl mx-auto">
    <div class="overflow-x-auto bg-white dark:bg-gray-800 rounded-xl shadow-lg p-4">
        <h2 class="text-2xl font-bold mb-4 text-gray-800 dark:text-gray-100">
            Audiobook Islambercerita
        </h2>

        <!-- Summary -->
        <div class="grid grid-cols-6 gap-4 mb-6">
            <div class="bg-green-100 dark:bg-green-800 p-4 rounded-lg text-center">
                <h3 class="text-lg font-semibold text-green-800 dark:text-green-200">Active</h3>
                <p id="totalActive" class="text-2xl font-bold text-green-800 dark:text-green-200">0</p>
            </div>
            <div class="bg-red-100 dark:bg-red-800 p-4 rounded-lg text-center">
                <h3 class="text-lg font-semibold text-red-800 dark:text-red-200">Deleted</h3>
                <p id="totalDeleted" class="text-2xl font-bold text-red-800 dark:text-red-200">0</p>
            </div>
        </div>

        <!-- Filters -->
        <div class="mb-4 flex flex-col sm:flex-row justify-between gap-4">
            <input id="tableSearch"
                   type="text"
                   placeholder="Search title / description..."
                   class="px-4 py-2 border rounded-lg w-full sm:w-64
                          dark:bg-gray-700 dark:text-white dark:border-gray-600">

            <select id="statusFilter"
                    class="px-4 py-2 border rounded-lg
                           dark:bg-gray-700 dark:text-white dark:border-gray-600">
                <option value="">ALL</option>
                <option value="Active">Active</option>
                <option value="Deleted">Deleted</option>
            </select>
        </div>

        <!-- Table -->
        <table id="audiobookTable"
               class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
            <thead class="bg-gray-50 dark:bg-gray-700">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-200 uppercase tracking-wider">Cover</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-200 uppercase tracking-wider">Title</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-200 uppercase tracking-wider">Series</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-200 uppercase tracking-wider">Description</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-200 uppercase tracking-wider">Duration</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-200 uppercase tracking-wider">Created At</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-200 uppercase tracking-wider">Audio</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-200 uppercase tracking-wider">Status</th>
                </tr>
            </thead>
            <tbody class="bg-white dark:bg-gray-800"></tbody>
        </table>

        <!-- Pagination -->
        <div class="mt-4 flex justify-between items-center">
            <button id="prevPage"
                    class="px-4 py-2 bg-blue-600 text-white rounded disabled:opacity-50">
                Previous
            </button>
            <span id="pageInfo">Page 1 of 1</span>
            <button id="nextPage"
                    class="px-4 py-2 bg-blue-600 text-white rounded disabled:opacity-50">
                Next
            </button>
        </div>
    </div>
</div>
<script>
    function playAudio(url, title) {
        $('#audioPlayerModal').remove();

        const modal = `
        <div id="audioPlayerModal" class="fixed inset-0 bg-black/70 flex items-center justify-center z-50">
            <div class="bg-white dark:bg-gray-800 rounded-xl p-6 max-w-lg w-full">
                <div class="flex justify-between mb-3">
                    <h3 class="font-bold text-lg text-gray-800 dark:text-gray-100">Now Playing</h3>
                    <button onclick="$('#audioPlayerModal').remove()">✕</button>
                </div>
                <p class="mb-3 text-center text-gray-600 dark:text-gray-300 truncate">${title}</p>
                <audio controls autoplay class="w-full" controlsList="nodownload">
                    <source src="${url}" type="audio/mpeg">
                </audio>
            </div>
        </div>`;
        $('body').append(modal);
    }

    function formatDate(d) {
        return d ? new Date(d).toLocaleDateString('en-GB') : '-';
    }

    $(function () {
        let currentPage = 1;
        const pageSize = 10;
        let totalPages = 1;

        function loadTable(search = "", status = "") {
            $.ajax({
                url: '/admin/audiobook/load-islambercerita',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    Skip: (currentPage - 1) * pageSize,
                    Take: pageSize,
                    Data: search,
                    Status: status
                }),
                success: function (res) {
                    const tbody = $('#audiobookTable tbody').empty();

                    if (!res.data?.length) {
                        tbody.append(`<tr><td colspan="8" class="text-center py-6">No data</td></tr>`);
                        return;
                    }

                    res.data.forEach(r => {
                        const cover = r.cover_image
                            ? `<img src="/Audiobook/${r.cover_image}" class="w-12 h-16 rounded">`
                            : '-';

                        const audioUrl = `/Audiobook/audio/islambercerita/${r.audiobook_id}.mp3`;

                        tbody.append(`
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
                            <td class="px-4 py-3">${cover}</td>
                            <td class="px-4 py-3 font-medium">${r.title}</td>
                            <td class="px-4 py-3 text-sm text-blue-600">
                                ${r.series_name || '-'}
                            </td>
                            <td class="px-4 py-3 text-sm truncate max-w-xs">${r.description || '-'}</td>
                            <td class="px-4 py-3">${r.duration || '-'} min</td>
                            <td class="px-4 py-3">${formatDate(r.created_date)}</td>
                            <td class="px-4 py-3">
                                <button onclick="playAudio('${audioUrl}', '${r.title.replace(/'/g, "\\'")}')"
                                        class="px-3 py-1 bg-blue-600 text-white rounded">
                                    Play
                                </button>
                            </td>
                            <td class="px-4 py-3">
                                <span class="px-2 py-1 rounded text-sm
                                    ${r.status === 'Active'
                                ? 'bg-green-200 text-green-800'
                                : 'bg-red-200 text-red-800'}">
                                    ${r.status}
                                </span>
                            </td>
                        </tr>`);
                    });

                    totalPages = Math.ceil(res.recordsFiltered / pageSize);
                    $('#totalActive').text(res.totalActive);
                    $('#totalDeleted').text(res.totalDeleted);
                    $('#pageInfo').text(`Page ${currentPage} of ${totalPages}`);
                }
            });
        }

        loadTable();

        $('#tableSearch').on('keyup', () => {
            currentPage = 1;
            loadTable($('#tableSearch').val(), $('#statusFilter').val());
        });

        $('#statusFilter').on('change', () => {
            currentPage = 1;
            loadTable($('#tableSearch').val(), $('#statusFilter').val());
        });

        $('#prevPage').click(() => {
            if (currentPage > 1) { currentPage--; loadTable(); }
        });

        $('#nextPage').click(() => {
            if (currentPage < totalPages) { currentPage++; loadTable(); }
        });
    });
</script>