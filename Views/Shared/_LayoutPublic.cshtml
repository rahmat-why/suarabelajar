@{
    var jagobacain = "https://www.instagram.com/jagobacain?igsh=MWw5YzY1Y2lhYzlmYg==";
    var islambercerita = "https://www.instagram.com/islambercerita.id?igsh=MTN6NG5kbjQ2cG9vMg==";
}

<!DOCTYPE html>
<html lang="en" class="h-full overflow-hidden">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Suara Belajar</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>

@* <body class="bg-black text-gray-200 h-full overflow-hidden flex flex-col"> *@
<body class="relative text-gray-200 h-full overflow-hidden flex flex-col bg-cover bg-center bg-no-repeat"
      style="background-image: url('/background.png');">
    <div class="absolute inset-0 bg-black/60 -z-10"></div>

    <!-- Header -->
    <header class="border-b border-gray-700 bg-black">
        <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">

            <!-- LEFT: TITLE + PACKAGES -->
            <div>
                <h1 class="text-xl text-white font-semibold">
                    suarabelajar.com
                </h1>

                <div class="flex items-center gap-4 mt-2 text-sm text-white/70">
                    <span class="flex items-center gap-2">
                        <img src="/jagobacainv2.png"
                             alt="Jagobacain"
                             class="w-6 h-6 object-contain">
                        jagobacain
                    </span>

                    <span class="flex items-center gap-2">
                        <img src="/islambercerita.png"
                             alt="Islam Bercerita"
                             class="w-6 h-6 object-contain">
                        islambercerita
                    </span>
                </div>
            </div>

        </div>
    </header>

    <!-- Main (NO SCROLL) -->
    <main class="flex-1 overflow-hidden flex items-center justify-center px-4">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="border-t border-gray-700 shrink-0 bg-black">
        <div class="max-w-6xl mx-auto px-4 py-4 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-gray-400">

            <div>
                © <span id="year"></span> suarabelajar. All rights reserved.
            </div>

            <div class="flex items-center gap-6">
                <a href="@jagobacain" target="_blank"
                   class="flex items-center gap-2 hover:text-white transition">
                    <img src="/jagobacainv2.png" class="w-5 h-5">
                    @@jagobacain
                </a>

                <a href="@islambercerita" target="_blank"
                   class="flex items-center gap-2 hover:text-white transition">
                    <img src="/islambercerita.png" class="w-5 h-5">
                    @@islambercerita
                </a>
            </div>
        </div>
    </footer>

    @RenderSection("Scripts", required: false)

    <script>
        document.getElementById("year").textContent = new Date().getFullYear();

        document.addEventListener("contextmenu", e => e.preventDefault());
        document.addEventListener("keydown", function (e) {
            if (e.key === "F12" || e.keyCode === 123) e.preventDefault();
            if (e.ctrlKey && e.shiftKey && ["I", "J", "C"].includes(e.key)) e.preventDefault();
            if (e.ctrlKey && ["U", "S"].includes(e.key)) e.preventDefault();
        });
    </script>
</body>
</html>